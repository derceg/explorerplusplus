set(VCPKG_POLICY_EMPTY_INCLUDE_FOLDER enabled)

set(TERMINAL_RELEASE_VERSION "1.22.10352.0")

if(VCPKG_TARGET_ARCHITECTURE STREQUAL "x86")
    set(TERMINAL_RELEASE_ARCH "x86")
    set(TERMINAL_ARCHIVE_SHA512 ced1d1222c375d5b69f195344aa9356b95e28d6c8414bd65717f466d5c88ad9e2fb9b5e6dd2568495b3f906d33e2888befee8c61e59e13004fd4b44197f1b89d)
elseif(VCPKG_TARGET_ARCHITECTURE STREQUAL "x64")
    set(TERMINAL_RELEASE_ARCH "x64")
    set(TERMINAL_ARCHIVE_SHA512 18993cdf3e408cc28584024d6e589e726049261ff60c09079b5fc95e780c5ceab045aed7ef25efbe3ace97d449d78a345cddef301b33e78b51fc357cee8ff25a)
elseif(VCPKG_TARGET_ARCHITECTURE STREQUAL "arm64")
    set(TERMINAL_RELEASE_ARCH "arm64")
    set(TERMINAL_ARCHIVE_SHA512 f0be2922de7faa4c77957dc4630e33e82cf6e766edbf000fb12daab805f3f0887695114970b5c235b2b799f132a341ffc2d84b0474d12ab6e95b7d1d6555035c)
else()
    message(FATAL_ERROR "Unsupported architecture: ${VCPKG_TARGET_ARCHITECTURE}")
endif()

set(TERMINAL_ARCHIVE_NAME "Microsoft.WindowsTerminal_${TERMINAL_RELEASE_VERSION}_${TERMINAL_RELEASE_ARCH}.zip")

vcpkg_download_distfile(
    ARCHIVE
    URLS "https://github.com/microsoft/terminal/releases/download/v${TERMINAL_RELEASE_VERSION}/${TERMINAL_ARCHIVE_NAME}"
    FILENAME "${TERMINAL_ARCHIVE_NAME}"
    SHA512 ${TERMINAL_ARCHIVE_SHA512}
)

set(SOURCE_PATH "${CURRENT_BUILDTREES_DIR}/src")
file(REMOVE_RECURSE "${SOURCE_PATH}")
file(MAKE_DIRECTORY "${SOURCE_PATH}")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${SOURCE_PATH}")

file(
    INSTALL "${SOURCE_PATH}/terminal-${TERMINAL_RELEASE_VERSION}/Microsoft.Terminal.Control.dll"
    DESTINATION "${CURRENT_PACKAGES_DIR}/tools/${PORT}"
)

vcpkg_install_copyright(FILE_LIST "${CMAKE_CURRENT_LIST_DIR}/copyright")
